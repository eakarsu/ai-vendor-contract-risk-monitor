DATABASE_URL=postgresql://vendor_risk_app:replace-me@db.example.internal:5432/vendor_risk
PGSSLROOTCERT=/run/secrets/postgres-ca.pem
GOVERNANCE_GATEWAY_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-an-independent-32-character-secret
ENABLE_DEMO_AUTH=false
PORT=5306

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
